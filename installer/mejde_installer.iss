; ==============================================================================
; Mejde Network - Inno Setup Script (مُثبّت مَجْد الاحترافي لنظام ويندوز)
; Compiles the standalone bundle into a single setup executable: Mejde_Setup_v1.0.0.exe
; ==============================================================================

#define MyAppName "Mejde"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Mejde Decentralized Network"
#define MyAppURL "https://mejde.network"
#define MyAppExeName "Mejde.exe"

[Setup]
; Basic Application Details
AppId={{5D8B41E2-F30A-4C2E-8E5F-B7329FA982E1}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Destination Directories
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

; Output Configuration
OutputDir=..\release
OutputBaseFilename=Mejde_Setup_v{#MyAppVersion}_x64
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; Platform Targeting
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Privileges and Visuals
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UninstallDisplayIcon={app}\public\logo.ico
SetupIconFile=..\installer\logo.ico

[Languages]
Name: "arabic"; MessagesFile: "compiler:Languages\Arabic.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; Standalone distribution bundle generated by scripts\build_desktop.bat
Source: "..\release\Mejde-Windows-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Parameters: "app.ring"; WorkingDir: "{app}"; IconFilename: "{app}\public\logo.ico"
Name: "{group}\Mejde Node Server (خادم النود المستقل)"; Filename: "{app}\{#MyAppExeName}"; Parameters: "node.ring 8545 social_mother.db"; WorkingDir: "{app}"; IconFilename: "{app}\public\logo.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Parameters: "app.ring"; WorkingDir: "{app}"; Tasks: desktopicon; IconFilename: "{app}\public\logo.ico"

[Registry]
; Register custom protocol: mejde://
Root: HKCU; Subkey: "Software\Classes\mejde"; ValueType: string; ValueName: ""; ValueData: "URL:Mejde Protocol"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\mejde"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: HKCU; Subkey: "Software\Classes\mejde\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""{app}\app.ring"" ""%1"""

[Run]
Filename: "{app}\{#MyAppExeName}"; Parameters: "app.ring"; WorkingDir: "{app}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
